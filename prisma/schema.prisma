generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPPORT
  CUSTOMER
}

enum QueryStatus {
  WAITING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVIEW
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REFUNDED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  creditAccount CreditAccount?
  payments      Payment[]
  queryRequests QueryRequest[]
  supportTickets SupportTicket[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  sessions      Session[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Plan {
  id                String         @id @default(cuid())
  name              String
  priceCents        Int
  active            Boolean        @default(true)
  version           Int            @default(1)
  creditsIncluded   Int
  validDays         Int?
  categoriesAllowed String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id         String    @id @default(cuid())
  userId     String
  planId     String
  status     String    @default("active")
  startsAt   DateTime  @default(now())
  renewsAt   DateTime?
  canceledAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  planId      String?
  amountCents Int
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CreditAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  transactions CreditTransaction[]
}

model CreditTransaction {
  id        String   @id @default(cuid())
  accountId String
  amount    Int
  type      String
  reason    String
  reference String?
  metadata  String?
  createdAt DateTime @default(now())

  account CreditAccount @relation(fields: [accountId], references: [id])
}

model QueryRequest {
  id               String      @id @default(cuid())
  userId           String
  category         String
  rawInput         String
  providerName     String      @default("mock")
  providerRequestId String?
  status           QueryStatus @default(WAITING)
  costCredits      Int         @default(0)
  attempts         Int         @default(0)
  correlationId    String?
  providerResult   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user  User               @relation(fields: [userId], references: [id])
  events QueryStatusEvent[]
}

model QueryStatusEvent {
  id        String      @id @default(cuid())
  requestId String
  status    QueryStatus
  note      String?
  createdAt DateTime    @default(now())

  request QueryRequest @relation(fields: [requestId], references: [id])
}

model ProviderConfiguration {
  id         String   @id @default(cuid())
  name       String
  enabled    Boolean  @default(false)
  type       String
  configJson String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id           String  @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  metadata     String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  status    String   @default("open")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Telegram integration models
model TelegramConnection {
  id         String           @id @default(cuid())
  name       String
  enabled    Boolean          @default(true)
  provider   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sessions   TelegramSession[]
  events     TelegramEvent[]
}

model TelegramSession {
  id            String   @id @default(cuid())
  connectionId  String
  fingerprint   String?
  encryptedBlob String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection TelegramConnection @relation(fields: [connectionId], references: [id])
}

model TelegramEvent {
  id           String   @id @default(cuid())
  connectionId String
  messageId    String?
  chatId       String
  from         String?
  text         String?
  direction    String
  correlationId String?
  payload      String?
  createdAt    DateTime @default(now())

  connection TelegramConnection @relation(fields: [connectionId], references: [id])
}
