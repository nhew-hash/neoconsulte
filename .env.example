# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# PostgreSQL (Neon, Supabase, Vercel Postgres ou local). Use a URL SEM pooler para `db:push`.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/neoconsulte?sslmode=require"
# Banco SEPARADO só para `npm test` (os testes apagam dados das tabelas!)
TEST_DATABASE_URL=

# Payments (optional)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Fila de consultas
QUERY_TRANSPORT=demo
QUERY_TIMEOUT_SECONDS=120
WORKER_INTERVAL_MS=2000
# Webhook de entrada generico (deixe vazio para manter o endpoint fechado)
INBOUND_SECRET=
# Chave de criptografia dos payloads/resultados (32 bytes em base64). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
