import { z } from 'zod';

const bodySchema = z.object({
  category: z.enum(['CPF', 'CNPJ', 'Nome', 'Telefone', 'Placa']),
  input: z.string().min(3),
  customerId: z.string().optional(),
});

export async function POST(request: Request) {
  try {
    const json = await request.json();
    const parsed = bodySchema.parse(json);

    const correlationId = `req_${Math.random().toString(36).slice(2, 10)}`;

    return Response.json({
      ok: true,
      requestId: correlationId,
      correlationId,
      status: 'queued',
      provider: 'mock',
      category: parsed.category,
      costCredits: 2,
      message: 'Operação registrada em modo demonstrativo. Nenhum dado real é apresentado.',
    });
  } catch (error) {
    return Response.json({ ok: false, error: 'Payload inválido' }, { status: 400 });
  }
}
